# Copy to .env and replace all empty credentials. No synthetic-model fallback exists.
DATABASE_URL=jdbc:mysql://localhost:3306/careflow
DATABASE_USER=careflow
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
BOOTSTRAP_TOKEN=
# 首个企业所有者的固定访问凭证；仅保存在部署机 .env，不要提交或对外分享。
DEFAULT_ACCESS_TOKEN=
# 仅本地测试使用；保持 false 可关闭测试模式快速登录。
DEMO_AUTH_ENABLED=false
INTERNAL_TOKEN=
RABBITMQ_HOST=localhost
RABBITMQ_USER=careflow
RABBITMQ_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=careflow
S3_SECRET_KEY=
S3_BUCKET=careflow
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
WORKER_URL=http://localhost:8090
BACKEND_URL=http://localhost:8080
# OpenAI-compatible embeddings; actual vector dimensions must match provider output.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=1024
# Cohere/Jina-compatible POST /rerank request/response contract.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
# OpenAI-compatible POST /chat/completions streaming contract.
GENERATION_BASE_URL=https://api.deepseek.com
GENERATION_API_KEY=
GENERATION_MODEL=deepseek-v4-flash

# Base64-encoded 32-byte AES key; store separately from database backups.
MODEL_CONFIG_ENCRYPTION_KEY=
# Exact approved base URLs, comma-separated. Local/self-hosted endpoints require explicit deployment approval.
MODEL_EXTERNAL_BASES=https://api.deepseek.com
MODEL_LOCAL_BASES=
# Docker Worker 将模型档案中的 localhost 地址转为宿主机地址；Compose 已默认注入
MODEL_HOST_ALIAS=host.docker.internal

# Parser hard caps; these deployment values may only tighten the defaults.
PARSE_MAX_PDF_PAGES=500
PARSE_MAX_IMAGE_PIXELS=40000000
PARSE_MAX_ARCHIVE_BYTES=209715200
PARSE_MAX_ARCHIVE_ENTRIES=10000
OCR_TIMEOUT_SECONDS=60
PARSE_TIMEOUT_SECONDS=600
PARSE_MEMORY_MIB=2048
