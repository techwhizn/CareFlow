{
  "openapi": "3.1.0",
  "info": {
    "title": "CareFlow Internal Worker",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/v1/recall": {
      "post": {
        "summary": "Recall",
        "operationId": "recall_internal_v1_recall_post",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Internal-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Recall"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecallResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/rerank": {
      "post": {
        "summary": "Rerank",
        "operationId": "rerank_internal_v1_rerank_post",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Internal-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rerank"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RerankResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/generate/stream": {
      "post": {
        "summary": "Stream",
        "operationId": "stream_internal_v1_generate_stream_post",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Internal-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Generate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/tokenize": {
      "post": {
        "summary": "Tokenize",
        "operationId": "tokenize_internal_v1_tokenize_post",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Internal-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Tokenize"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenizeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Candidate": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "content"
        ],
        "title": "Candidate"
      },
      "Generate": {
        "properties": {
          "model_configuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelConfiguration"
              },
              {
                "type": "null"
              }
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "evidence"
        ],
        "title": "Generate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hit": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Hit"
      },
      "ModelConfiguration": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "EMBEDDING",
              "RERANK",
              "GENERATION"
            ],
            "title": "Kind"
          },
          "base_url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Base Url"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "revision": {
            "type": "string",
            "maxLength": 200,
            "title": "Revision",
            "default": ""
          },
          "dimensions": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65536.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimensions"
          },
          "api_key": {
            "type": "string",
            "maxLength": 8192,
            "format": "password",
            "title": "Api Key",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "base_url",
          "model"
        ],
        "title": "ModelConfiguration"
      },
      "Recall": {
        "properties": {
          "model_configuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelConfiguration"
              },
              {
                "type": "null"
              }
            ]
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Tenant Id"
          },
          "version_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10000,
            "title": "Version Ids"
          },
          "expected_model_identity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Model Identity"
          },
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "semantic",
              "keyword"
            ],
            "title": "Mode",
            "default": "hybrid"
          },
          "allow_degraded": {
            "type": "boolean",
            "title": "Allow Degraded",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id",
          "version_ids",
          "query"
        ],
        "title": "Recall"
      },
      "RecallResponse": {
        "properties": {
          "dense": {
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Dense"
          },
          "bm25": {
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Bm25"
          },
          "fused": {
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Fused"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dense",
          "bm25",
          "fused",
          "degraded"
        ],
        "title": "RecallResponse"
      },
      "Rerank": {
        "properties": {
          "model_configuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelConfiguration"
              },
              {
                "type": "null"
              }
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Candidates"
          },
          "allow_degraded": {
            "type": "boolean",
            "title": "Allow Degraded",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "candidates"
        ],
        "title": "Rerank"
      },
      "RerankResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Results"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "results",
          "degraded"
        ],
        "title": "RerankResponse"
      },
      "Tokenize": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Tokenize"
      },
      "TokenizeResponse": {
        "properties": {
          "token_count": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Token Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token_count"
        ],
        "title": "TokenizeResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
