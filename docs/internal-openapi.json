  "components": {
    "schemas": {
      "CachePurge": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/CacheReference"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Entries"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id",
          "entries"
        ],
        "title": "CachePurge"
      },
      "CacheReference": {
        "properties": {
          "model_identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Model Identity"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_identity",
          "content_hash"
        ],
        "title": "CacheReference"
      },
      "Candidate": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "content"
        ],
        "title": "Candidate"
      },
      "ChunkingConfiguration": {
        "properties": {
          "target": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Target"
          },
          "maximum": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Maximum"
          },
          "overlap": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 0.0,
            "title": "Overlap"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "recursive",
              "token"
            ],
            "title": "Strategy",
            "default": "recursive"
          },
          "include_context": {
            "type": "boolean",
            "title": "Include Context",
            "default": true
          },
          "model_tokenizer": {
            "type": "string",
            "enum": [
              "cl100k_base",
              "provider"
            ],
            "title": "Model Tokenizer",
            "default": "cl100k_base"
          },
          "model_maximum": {
            "type": "integer",
            "maximum": 131072.0,
            "minimum": 1.0,
            "title": "Model Maximum",
            "default": 600
          },
          "layout": {
            "type": "string",
            "enum": [
              "standard",
              "parent_child",
              "faq"
            ],
            "title": "Layout",
            "default": "standard"
          },
          "parent_maximum": {
            "type": "integer",
            "maximum": 1600.0,
            "minimum": 1.0,
            "title": "Parent Maximum",
            "default": 1600
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target",
          "maximum",
          "overlap"
        ],
        "title": "ChunkingConfiguration"
      },
      "Compaction": {
        "properties": {
          "collection": {
            "type": "string",
            "maxLength": 255,
            "title": "Collection"
          },
          "job_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Job Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "collection",
          "job_id"
        ],
        "title": "Compaction"
      },
      "CompactionRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "compactions": {
            "items": {
              "$ref": "#/components/schemas/Compaction"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Compactions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id",
          "compactions"
        ],
        "title": "CompactionRequest"
      },
      "CompactionResponse": {
        "properties": {
          "complete": {
            "type": "boolean",
            "title": "Complete"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "complete"
        ],
        "title": "CompactionResponse"
      },
      "Generate": {
        "properties": {
          "model_configuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelConfiguration"
              },
              {
                "type": "null"
              }
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "evidence"
        ],
        "title": "Generate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hit": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Hit"
      },
      "IndexEntry": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Id"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "content_hash"
        ],
        "title": "IndexEntry"
      },
      "IndexPurge": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "version_id": {
            "type": "string",
            "title": "Version Id"
          },
          "generation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id",
          "version_id"
        ],
        "title": "IndexPurge"
      },
      "IndexVerification": {
        "properties": {
          "model_configuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelConfiguration"
              },
              {
                "type": "null"
              }
            ]
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "version_id": {
            "type": "string",
            "title": "Version Id"
          },
          "generation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Id"
          },
          "expected_model_identity": {
            "type": "string",
            "title": "Expected Model Identity"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/IndexEntry"
            },
            "type": "array",
            "maxItems": 50000,
            "title": "Chunks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id",
          "version_id",
          "expected_model_identity",
          "chunks"
        ],
        "title": "IndexVerification"
      },
      "IndexVerificationResponse": {
        "properties": {
          "consistent": {
            "type": "boolean",
            "title": "Consistent"
          },
          "expected_count": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 0.0,
            "title": "Expected Count"
          },
          "actual_count": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 0.0,
            "title": "Actual Count"
          },
          "missing_count": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 0.0,
            "title": "Missing Count"
          },
          "extra_count": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 0.0,
            "title": "Extra Count"
          },
          "mismatched_count": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 0.0,
            "title": "Mismatched Count"
          },
          "manifest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Manifest"
          },
          "samples": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Samples"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "consistent",
          "expected_count",
          "actual_count",
          "missing_count",
          "extra_count",
          "mismatched_count",
          "manifest",
          "samples"
        ],
        "title": "IndexVerificationResponse"
      },
      "LegacyCachePurge": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_id"
        ],
        "title": "LegacyCachePurge"
      },
      "ManualFaq": {
        "properties": {
          "model_configuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelConfiguration"
              },
              {
                "type": "null"
              }
            ]
          },
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "alternatives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Alternatives"
          },
          "answer": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Answer"
          },
          "chunking": {
            "$ref": "#/components/schemas/ChunkingConfiguration"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "answer",
          "chunking"
        ],
        "title": "ManualFaq"
      },
      "ModelConfiguration": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "EMBEDDING",
              "RERANK",
              "GENERATION"
            ],
            "title": "Kind"
          },
          "base_url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Base Url"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "revision": {
            "type": "string",
            "maxLength": 200,
            "title": "Revision",
            "default": ""
          },
          "dimensions": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65536.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimensions"
          },
          "api_key": {
            "type": "string",
            "maxLength": 8192,
            "format": "password",
            "title": "Api Key",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
