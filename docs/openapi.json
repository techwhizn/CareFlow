  "components": {
    "schemas": {
      "Quota": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reason"
        ]
      },
      "Input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "kind": {
            "type": "string",
            "pattern": "GENERATION|EMBEDDING|RERANK"
          },
          "base_url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "model_revision": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "dimensions": {
            "type": "integer",
            "format": "int32",
            "maximum": 65536,
            "minimum": 1
          },
          "external_processing": {
            "type": "boolean"
          },
          "api_key": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 0
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "base_url",
          "kind",
          "model",
          "model_revision",
          "name"
        ]
      },
      "View": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "model_revision": {
            "type": "string"
          },
          "dimensions": {
            "type": "integer",
            "format": "int32"
          },
          "external_processing": {
            "type": "boolean"
          },
          "key_configured": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "State": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "ACTIVE|ARCHIVED|DELETED"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Acl": {
        "type": "object",
        "properties": {
          "grants": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "grants"
        ]
      },
      "Edit": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "content",
          "reason"
        ]
      },
      "Bind": {
        "type": "object",
        "properties": {
          "knowledge_base_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "allow_degraded": {
            "type": "boolean"
          }
        },
        "required": [
          "knowledge_base_ids"
        ]
      },
      "Query": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "application_id": {
            "type": "string"
          },
          "knowledge_base_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "debug": {
            "type": "boolean"
          },
          "minimum_rerank_score": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "role": {
            "type": "string",
            "pattern": "ADMIN|KNOWLEDGE_MANAGER|DEVELOPER|USER"
          }
        },
        "required": [
          "name"
        ]
      },
      "Named": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "Publish": {
        "type": "object",
        "properties": {
          "version_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "version_id"
        ]
      },
      "ConfigurationPublish": {
        "type": "object",
        "properties": {
          "configuration_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "configuration_id"
        ]
      },
      "SseEmitter": {
        "type": "object",
        "properties": {
          "timeout": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
