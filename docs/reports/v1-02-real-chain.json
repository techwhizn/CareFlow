        "data:{\"evidence\":[{\"id\":\"44fcf269-161f-46b6-b7fb-2a7c6161430a\",\"tenant_id\":\"8ede50df-947e-467c-8096-0c3c44789617\",\"version_id\":\"a83c54d5-9b3e-4202-bd45-4de76c17a950\",\"ordinal_no\":1,\"content\":\"## 连接失败 E404\\n\\nCF-100 显示 E404 表示无法连接到配置的服务地址。先检查网络连接，再核对服务地址。修改地址后重启连接过程。不要删除本地资料。\",\"location\":\"{\\\"type\\\": \\\"text\\\", \\\"start\\\": 51, \\\"end\\\": 134, \\\"title_path\\\": [\\\"CareFlow CF-100 设备参考手册\\\", \\\"连接失败 E404\\\"], \\\"block_start\\\": 0, \\\"block_end\\\": 83, \\\"cleaning\\\": {\\\"whitespace_normalized\\\": true, \\\"ignored_spans\\\": []}, \\\"warning\\\": \\\"\\\"}\",\"token_count\":56,\"enabled\":true,\"revision\":0,\"document_id\":\"bdc9ba51-b7cf-428c-b9bf-c6d11b1f2331\",\"title\":\"product-guide.md\"},{\"id\":\"16e2fabf-b70b-4272-b69b-b66b2a9e0f02\",\"tenant_id\":\"8ede50df-947e-467c-8096-0c3c44789617\",\"version_id\":\"a83c54d5-9b3e-4202-bd45-4de76c17a950\",\"ordinal_no\":0,\"content\":\"# CareFlow CF-100 设备参考手册\\n\\n这是用于软件测试的合成资料，不适用于真实设备。\",\"location\":\"{\\\"type\\\": \\\"text\\\", \\\"start\\\": 0, \\\"end\\\": 51, \\\"title_path\\\": [\\\"CareFlow CF-100 设备参考手册\\\"], \\\"block_start\\\": 0, \\\"block_end\\\": 51, \\\"cleaning\\\": {\\\"whitespace_normalized\\\": true, \\\"ignored_spans\\\": []}, \\\"warning\\\": \\\"\\\"}\",\"token_count\":36,\"enabled\":true,\"revision\":0,\"document_id\":\"bdc9ba51-b7cf-428c-b9bf-c6d11b1f2331\",\"title\":\"product-guide.md\"},{\"id\":\"03f3ad2e-94bd-4420-bfea-70c6ca936980\",\"tenant_id\":\"8ede50df-947e-467c-8096-0c3c44789617\",\"version_id\":\"a83c54d5-9b3e-4202-bd45-4de76c17a950\",\"ordinal_no\":3,\"content\":\"## 存储容量\\n\\n测试型号 CF-100 的演示存储上限为 64 GB。此参数仅为测试场景，不代表真实产品。\",\"location\":\"{\\\"type\\\": \\\"text\\\", \\\"start\\\": 185, \\\"end\\\": 241, \\\"title_path\\\": [\\\"CareFlow CF-100 设备参考手册\\\", \\\"存储容量\\\"], \\\"block_start\\\": 0, \\\"block_end\\\": 56, \\\"cleaning\\\": {\\\"whitespace_normalized\\\": true, \\\"ignored_spans\\\": []}, \\\"warning\\\": \\\"\\\"